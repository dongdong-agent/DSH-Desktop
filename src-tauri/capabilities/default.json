{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DSH Desktop 主窗口能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "node", "cmd": "node", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "pnpm", "cmd": "pnpm", "args": true },
        { "name": "winget", "cmd": "winget", "args": true },
        { "name": "dsh", "cmd": "dsh", "args": true },
        { "name": "dsh.cmd", "cmd": "dsh.cmd", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "node", "cmd": "node", "args": true },
        { "name": "dsh", "cmd": "dsh", "args": true },
        { "name": "dsh.cmd", "cmd": "dsh.cmd", "args": true }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "fs:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA/com.dsh.desktop/**" },
        { "path": "$HOME/AppData/Local/pnpm/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/com.dsh.desktop/kernel/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "C:\\Program Files\\nodejs\\**" }, { "path": "C:\\**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.dsh/**" },
        { "path": "$APPDATA/KeySwitch/**" },
        { "path": "$APPDATA/com.dsh.desktop/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "C:\\Windows\\Temp\\**" },
        { "path": "$HOME/.dsh/**" },
        { "path": "$APPDATA/com.dsh.desktop/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/com.dsh.desktop/kernel/**" }]
    },
    "dialog:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "https://registry.npmjs.org/**" }
      ]
    }
  ]
}
